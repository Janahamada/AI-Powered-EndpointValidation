# Copy to backend/.env and adjust. All values have safe defaults in app/config.py.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (SPA origins, comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Defaults to the SQLite file at the repo root.
# DATABASE_URL=sqlite:///../endpoint_security.db

# --- Auth / JWT (CHANGE SECRET_KEY IN PRODUCTION) ---
SECRET_KEY=CHANGE-ME-in-production-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@endpointassurance.local

# --- AI / Ollama (optional; app works fully without it) ---
AI_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
# Hybrid: stronger model for explanation Q&A, fast model for the on-demand summary.
EXPLANATION_MODEL=llama3.1:8b
SUMMARY_MODEL=smollm2:1.7b

# --- Evaluation reference time ---
# Empty  -> anchor freshness to the dataset's newest evidence timestamp (recommended for the static demo dataset).
# "now"  -> use the real wall clock (once live evidence is flowing).
# ISO    -> pin to a fixed instant, e.g. 2026-07-18T18:13:00
EVAL_REFERENCE_TIME=
